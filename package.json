{
  "name": "bluepy",
  "version": "0.0.1",
  "private": true,
  "description": "BluePy – a BlueJ-style teaching IDE for Python",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bluepy/desktop dev",
    "build": "pnpm --filter @bluepy/desktop build",
    "dist": "pnpm --filter @bluepy/desktop dist",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:backend": "python3 -m unittest discover -s backend/tests -t backend -v"
  }
}
